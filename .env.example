# ============================================================
# ATTENDER — Environment Variables Example
# Copy to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# App
APP_NAME=Attender
APP_ENV=development
DEBUG=true

# Database (Supabase PostgreSQL with pgvector)
DB_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql+asyncpg://attender:your_strong_password_here@db:5432/attender

# For Supabase (production):
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# JWT Security
SECRET_KEY=generate-with-openssl-rand-hex-32
LIVENESS_TOKEN_SECRET=generate-another-random-secret

# Redis (local Docker or Upstash)
REDIS_URL=redis://redis:6379/0
# For Upstash: REDIS_URL=rediss://default:[token]@[endpoint]:6379

# Face Recognition
FACE_SIMILARITY_THRESHOLD=0.85
LIVENESS_SCORE_THRESHOLD=0.85

# Email (Resend)
RESEND_API_KEY=re_...

# Supabase Storage (for profile photos, exports)
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# CORS (comma-separated for production)
CORS_ORIGINS=["http://localhost:5173","https://your-domain.vercel.app"]
